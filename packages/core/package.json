{
  "name": "@gagandeep023/support-chat-core",
  "version": "0.1.2",
  "description": "Shared types, wire protocol, and provider interfaces for support-chat.",
  "keywords": [
    "support-chat",
    "customer-support",
    "ai-chat",
    "wire-protocol",
    "zod",
    "typescript",
    "self-hosted",
    "gagan",
    "gagandeep",
    "gagandeep bhatia"
  ],
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js",
      "require": "./dist/protocol/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gagandeep023/support-chat.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Gagandeep023/support-chat#readme",
  "bugs": {
    "url": "https://github.com/Gagandeep023/support-chat/issues"
  },
  "author": "Gagandeep Bhatia",
  "publishConfig": {
    "access": "public"
  }
}
