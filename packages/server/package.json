{
  "name": "@gagandeep023/support-chat-server",
  "version": "0.1.1",
  "description": "Mountable support-chat engine: HTTP router, socket gateway, and store interfaces.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters/memory": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "require": "./dist/adapters/index.cjs"
    },
    "./adapters/sqlite": {
      "types": "./dist/adapters/sqlite.d.ts",
      "import": "./dist/adapters/sqlite.js",
      "require": "./dist/adapters/sqlite.cjs"
    },
    "./adapters/postgres": {
      "types": "./dist/adapters/postgres.d.ts",
      "import": "./dist/adapters/postgres.js",
      "require": "./dist/adapters/postgres.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./adapters/redis": {
      "types": "./dist/adapters/redis.d.ts",
      "import": "./dist/adapters/redis.js",
      "require": "./dist/adapters/redis.cjs"
    },
    "./adapters/pgvector": {
      "types": "./dist/adapters/pgvector.d.ts",
      "import": "./dist/adapters/pgvector.js",
      "require": "./dist/adapters/pgvector.cjs"
    },
    "./embeddings": {
      "types": "./dist/embeddings/index.d.ts",
      "import": "./dist/embeddings/index.js",
      "require": "./dist/embeddings/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@gagandeep023/support-chat-core": "^0.1.0",
    "socket.io": "^4.8.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@huggingface/transformers": "^4.2.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/pg": "^8.11.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "socket.io-client": "^4.8.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@huggingface/transformers": ">=3",
    "@socket.io/redis-adapter": "^8.3.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "vitest": ">=2"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": "true"
    },
    "pg": {
      "optional": "true"
    },
    "vitest": {
      "optional": true
    },
    "ioredis": {
      "optional": "true"
    },
    "@socket.io/redis-adapter": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gagandeep023/support-chat.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/Gagandeep023/support-chat#readme",
  "bugs": {
    "url": "https://github.com/Gagandeep023/support-chat/issues"
  },
  "author": "Gagandeep Bhatia",
  "publishConfig": {
    "access": "public"
  }
}
